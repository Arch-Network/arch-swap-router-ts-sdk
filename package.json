{
  "name": "@arch-network/swap-router-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Arch swap router quotes and instructions.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arch-Network/arch-swap-router-ts-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.types.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arch-network/arch-sdk": "^0.0.31"
  },
  "devDependencies": {
    "@scure/base": "1.2.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
